{
  "name": "next-instapok",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run sw:build",
    "build": "next build",
    "start": "next start",
    "sw:build": "npm run typecheck:sw && tsx src/server/scripts/buildServiceWorker",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "lint+fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "init": "tsx src/server/scripts/init",
    "icons": "tsx src/server/scripts/generatePwaIcons"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "pg": "^8.16.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.2",
    "esbuild": "~0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
